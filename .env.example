# Optional live agent only. Never commit a real provider key.
OPENAI_API_KEY=
# Required live-model pricing: integer micro-USD per million tokens.
# Set these to conservative upper rates for the explicitly selected model,
# including image input and reasoning output. 1 USD = 1,000,000 micro-USD.
REPLEX_AGENT_INPUT_MICRO_USD_PER_MILLION=
REPLEX_AGENT_OUTPUT_MICRO_USD_PER_MILLION=
# Defaults: USD 0.10 per job; 12 provider requests/minute per workspace.
# Each generation also requires an input-count request (two rate slots).
REPLEX_AGENT_MAX_JOB_MICRO_USD=100000
REPLEX_AGENT_REQUESTS_PER_MINUTE=12

# Optional direct trusted media tools for the local demo (leave commented to use PATH).
# REPLEX_FFMPEG_PATH=/absolute/path/to/ffmpeg
# REPLEX_FFPROBE_PATH=/absolute/path/to/ffprobe
# REPLEX_FONT_FILE=/absolute/path/to/font.ttf
